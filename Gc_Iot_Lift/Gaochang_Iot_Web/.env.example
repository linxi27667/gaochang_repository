# ===== 基础服务 =====
PORT=3100

# ===== 数据库 =====
# SQLite 数据库文件路径(相对路径相对于项目根目录)
DB_PATH=./data/gaochang_lift.db

# ===== MQTT =====
MQTT_BROKER=mqtt://mqtt.gclift.net:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# 旧主题前缀(兼容期使用,最多只允许 1 台旧固件接入)
MQTT_TOPIC_PREFIX=gaochang/lift
MQTT_GATEWAY_ID=f407zet6
MQTT_DEVICE_ID=gaochang_lift_f407zet6

# v1 协议主题前缀(基于 chip_uid 的精确主题)
MQTT_V1_PREFIX=gaochang/lift/v1
# 上下行 QoS(推荐 1,保证至少一次送达 + 应用层去重)
MQTT_QOS=1
# 旧主题兼容开关(过渡期 true,四套固件全部升级后改为 false)
MQTT_LEGACY_ENABLED=true
# 旧主题允许接入的最大设备数(限制为 1,避免多台旧固件串命令)
MQTT_LEGACY_MAX_DEVICES=1

# ===== 去重 =====
# QoS 1 重复消息去重窗口(毫秒),默认 5 分钟
OFFLINE_DEDUP_WINDOW_MS=300000
# 去重缓存最大条目数,默认 1000
OFFLINE_DEDUP_MAX=1000

# ===== 绑定 =====
# 绑定码哈希盐值(正式部署必须修改,长度建议 >= 32 字节)
BIND_CODE_SALT=gaochang_lift_default_salt_2026
# 自动审批上限:前 N 人直接绑定成功,第 N+1 人开始进入待审批
BINDING_AUTO_APPROVE_LIMIT=3

# ===== 命令状态机 =====
# 单条命令超时时间(毫秒),默认 15 秒
CMD_TIMEOUT_MS=15000
# 单条命令最大重试次数(含首次),默认 2
CMD_MAX_ATTEMPTS=2
# 命令重试间隔(毫秒),默认 3 秒
CMD_RETRY_DELAY_MS=3000
# Same-msg-id fast copies for lock/unlock, used to avoid the DTU half-duplex TX window.
CMD_REDUNDANT_DELAYS_MS=1300,2900
# Random offset added to each fast copy so retries do not phase-lock to telemetry.
CMD_REDUNDANT_JITTER_MS=350

# ===== JWT =====
# JWT 签名密钥(正式部署必须修改为足够长的随机串)
JWT_SECRET=replace_with_a_long_random_secret
# JWT 过期时间(例如 7d / 12h / 30m)
JWT_EXPIRES_IN=7d

# ===== AI =====
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_API_KEY=replace_with_your_key
